{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "authors"],
  "properties": {
    "version": {"type": "integer"},
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "assetPath"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "description": {"type": "string"},
          "worksCount": {"type": "integer"},
          "assetPath": {"type": "string"},
          "sourceRank": {"type": "string"}
        }
      }
    }
  }
}
